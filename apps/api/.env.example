NODE_ENV=development
PORT=4000

# Postgres connection used by the runtime app.
# Locally: direct connection to your local postgres (managed via pgAdmin/psql).
# On Vercel: Supabase Transaction Pooler (port 6543) — pgbouncer-friendly for serverless.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Optional. Set only when DATABASE_URL points at a pgbouncer transaction pooler
# (Supabase Transaction Pooler on port 6543). Migrations require prepared statements
# and session-level operations, which transaction-mode poolers don't support — so the
# TypeORM CLI talks through this URL instead. On Vercel use Supabase Session Pooler
# (same host as Transaction Pooler, port 5432) or Direct connection (IPv6-only).
# Locally leave this unset — DATABASE_URL is used for both runtime and migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed Origins for CORS. Vercel single-domain deploys
# can keep just the prod URL here; preview deploys need their own URL or a wildcard pattern.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# Super-admins are created via CLI, not env seed:
#   pnpm --filter @app/api super-admin create --login=X --email=Y --password=Z
#   pnpm --filter @app/api super-admin promote --login=X

# Swagger UI at /api/docs. Defaults to "true". Set to "false" to hide in any env.
ENABLE_SWAGGER=true

# DELETE /api/testing/all-data wipe endpoint. Auto-enabled outside production.
# Set to "true" in production only when running an external auto-checker against the deployed API.
ENABLE_TESTING_ENDPOINTS=false

JWT_SECRET=replace-with-64-char-random-hex-string-generated-via-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=2h

# URL of the FE used to build email confirmation links.
# On Vercel set to your production domain (same domain as API in a single-Vercel-project setup).
FRONTEND_URL=http://localhost:5173

# Email sender + generic SMTP transport.
# Dev: Mailtrap sandbox (default). Prod: Resend (smtp.resend.com:587, user="resend"), Postmark, SES — any SMTP provider works.
EMAIL_FROM=no-reply@example.com
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
